{
  "recipe_name": "QA - Blue Cube Pick and Place",
  "description": "Full pick-and-place sequence for blue_cube alone, mirroring L4 but with the second dictionary object for grasp-orientation/coverage variety",
  "steps": [
    {
      "step_id": 1,
      "action": "home",
      "description": "Reset arm to home position"
    },
    {
      "step_id": 2,
      "action": "gripper",
      "parameters": { "position": 1.0 },
      "description": "Open gripper"
    },
    {
      "step_id": 3,
      "action": "move_arm",
      "parameters": { "target": "blue_cube" },
      "description": "Move to blue cube position"
    },
    {
      "step_id": 4,
      "action": "gripper",
      "parameters": { "position": 0.0 },
      "description": "Close gripper to grab cube"
    },
    {
      "step_id": 5,
      "action": "relative_move",
      "parameters": { "vector": "move_upwards" },
      "description": "Lift cube upwards"
    },
    {
      "step_id": 6,
      "action": "move_arm",
      "parameters": { "target": "delivery_tray" },
      "description": "Move to delivery tray"
    },
    {
      "step_id": 7,
      "action": "gripper",
      "parameters": { "position": 1.0 },
      "description": "Release cube into tray"
    },
    {
      "step_id": 8,
      "action": "home",
      "description": "Return to home position"
    }
  ]
}
