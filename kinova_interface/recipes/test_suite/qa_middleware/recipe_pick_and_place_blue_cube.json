{
  "recipe_name": "QA - Pick and Place, Blue Cube",
  "description": "Full pick-and-place cycle: grasp the blue cube and relocate it to the delivery tray",
  "steps": [
    {
      "step_id": 1,
      "action": "home",
      "description": "Reset arm to home position"
    },
    {
      "step_id": 2,
      "action": "pickup",
      "description": "Grasp the blue cube",
      "parameters": {
        "target": "blue_cube"
      }
    },
    {
      "step_id": 3,
      "action": "dropoff",
      "description": "Relocate it to the delivery tray",
      "parameters": {
        "destination": "delivery_tray"
      }
    },
    {
      "step_id": 4,
      "action": "home",
      "description": "Return home"
    }
  ]
}
