{
  "recipe_name": "Orientation and Speed Demo",
  "description": "Demonstrates the optional orientation preset and speed parameters: moves to the blue cube with the gripper pointing straight down at 30 percent speed, lifts, then returns home at 50 percent speed.",
  "steps": [
    {
      "step_id": 1,
      "action": "home",
      "description": "Start at home"
    },
    {
      "step_id": 2,
      "action": "gripper",
      "parameters": {
        "position": 0.0
      },
      "description": "Open the gripper so the fingers clear the cube"
    },
    {
      "step_id": 3,
      "action": "move_arm",
      "parameters": {
        "target": "blue_cube",
        "orientation": "top_down",
        "speed": 0.3
      },
      "description": "Move to the blue cube pointing straight down, at 30 percent speed"
    },
    {
      "step_id": 4,
      "action": "relative_move",
      "parameters": {
        "vector": "move_upwards"
      },
      "description": "Lift straight up"
    },
    {
      "step_id": 5,
      "action": "home",
      "parameters": {
        "speed": 0.5
      },
      "description": "Return home at 50 percent speed"
    }
  ]
}
